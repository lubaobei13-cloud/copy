<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy · 剪贴板" Width="380" Height="340" MinWidth="340" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F4F6F4"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" Foreground="#202B40"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="12" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#65718A"/><Setter Property="Padding" Value="9,5"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E8EDE9"/><Setter Property="Foreground" Value="#536E62"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="Background" Value="#DFE8E2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#77839A"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E8EDE9"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E5ECE7"/><Setter Property="Foreground" Value="#536E62"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Card" Background="White" BorderBrush="#E4E9F2" BorderThickness="1" CornerRadius="10"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#9FB5A7"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#B5C5B9"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#DCE3EF" BorderThickness="1" Padding="16,14,16,10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,15">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Width="35" Height="35" Margin="0,0,10,0" Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1"><TextBlock Text="copy" FontFamily="Segoe UI" FontWeight="Bold" FontSize="20" Margin="0,-3,0,0"/><TextBlock Text="每一次复制，都能找回来" Foreground="#8590A4" FontSize="10"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="PauseButton" Content="暂停" ToolTip="暂停记录" Padding="7,5"/>
          <Button x:Name="CloseButton" Content="×" FontSize="19" Padding="8,0" ToolTip="收起到托盘（继续记录）" AutomationProperties.Name="收起到托盘"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="White" BorderBrush="#DFE5EF" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
        <Grid>
          <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="12" AutomationProperties.Name="搜索复制记录"/>
          <TextBlock Text="搜索复制记录…" Foreground="#929DAF" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>
      <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,12" x:Name="Filters">
        <ToggleButton Content="全部" Tag="all" IsChecked="True"/><ToggleButton Content="文字" Tag="text"/><ToggleButton Content="图片" Tag="image"/><ToggleButton Content="文件" Tag="files"/><ToggleButton Content="置顶" Tag="pinned"/>
      </UniformGrid>
      <Grid Grid.Row="3">
        <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="复制历史">
          <ListBox.ItemTemplate><DataTemplate>
            <StackPanel>
              <Button Tag="copy" HorizontalContentAlignment="Stretch" Padding="12,11,12,5" ToolTip="点击重新复制，然后到目标窗口按 Ctrl + V" AutomationProperties.Name="{Binding Preview}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,7">
                    <TextBlock DockPanel.Dock="Right" Text="已置顶" Foreground="#60796E" FontSize="10" Visibility="{Binding PinVisibility}"/>
                    <TextBlock Text="{Binding Label}" Foreground="#8590A4" FontSize="10"/>
                  </DockPanel>
                  <Image Source="{Binding Thumbnail}" Height="94" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,5" Visibility="{Binding ImageVisibility}"/>
                  <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" LineHeight="19" Foreground="#2A354A" FontSize="12"/>
                </StackPanel>
              </Button>
              <Grid Margin="12,0,6,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeLabel}" Foreground="#9AA4B6" FontSize="10" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Tag="detail" Content="展开" Padding="6,4" FontSize="10"/>
                  <Button Tag="pin" Content="{Binding PinLabel}" Padding="6,4" FontSize="10"/>
                  <Button Tag="delete" Content="删除" Padding="6,4" FontSize="10"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,25">
          <Border Background="#E8EEE8" CornerRadius="16" Width="58" Height="58" Margin="0,0,0,14"><TextBlock Text="⧉" FontFamily="Segoe UI Symbol" FontSize="32" Foreground="#829B8A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock x:Name="EmptyTitle" Text="从下一次复制开始" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHint" Text="复制文字、图片或文件，它们会出现在这里" FontSize="10" Foreground="#929DAF" Margin="0,9,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="4" Margin="0,6,0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="● 正在记录" Foreground="#338A6B" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Button Grid.Column="1" x:Name="MenuButton" Content="设置 ···" Padding="7,4" FontSize="11"/>
      </Grid>
      <DockPanel Grid.Row="5">
        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="#9AA4B6" FontSize="10"/>
        <TextBlock Text="Ctrl + Alt + V 呼出  ·  点击记录复制" Foreground="#9AA4B6" FontSize="10"/>
      </DockPanel>
    </Grid>
  </Border>
</Window>
